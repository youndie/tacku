.DS_Store

# Go
/server/bin/
/probes/*/probe

# Gradle / JVM
.gradle/
build/
local.properties

# The generated spec in /spec IS committed: the Go half cannot run the generator, so it reads
# finished JSON. Drift is caught by client/spec-gen's golden test, not by ignoring the files.

# Worktrees of parallel agents: working copies of this same repository, not content of it.
.claude/worktrees/

# A binary `go build ./...` leaves beside its own source. The name is the package's, so it looks
# like a file somebody wrote.
/server/cmd/devauth/devauth
