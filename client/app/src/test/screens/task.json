           {
            "type": "read_only_field",
            "id": "task-assignee",
            "modifiers": [
             {
              "type": "background",
              "color": "surface_field"
             },
             {
              "type": "padding",
              "all": 12
             }
            ],
            "label": "Assignee",
            "value": "ivan"
           },
           {
            "type": "read_only_field",
            "id": "task-due",
            "modifiers": [
             {
              "type": "background",
              "color": "surface_field"
             },
             {
              "type": "padding",
              "all": 12
             }
