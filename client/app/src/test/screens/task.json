      "modifiers": [
       {
        "type": "size",
        "widthDp": 320
       }
      ],
      "children": [
       {
        "type": "read_only_field",
        "id": "task-status",
        "modifiers": [
         {
          "type": "background",
          "color": "surface_field"
         },
         {
          "type": "padding",
          "all": 12
         }
        ],
        "label": "Status",
        "value": "To do"
       },
       {
        "type": "read_only_field",
        "id": "task-assignee",
        "modifiers": [
         {
          "type": "background",
          "color": "surface_field"
         },
         {
          "type": "padding",
          "all": 12
         }
        ],
        "label": "Assignee",
        "value": "ivan"
       },
       {
        "type": "read_only_field",
        "id": "task-due",
        "modifiers": [
         {
          "type": "background",
          "color": "surface_field"
         },
         {
          "type": "padding",
          "all": 12
         }
        ],
        "label": "Due",
        "value": "29 Aug"
       },
       {
        "type": "read_only_field",
        "id": "task-board",
        "modifiers": [
         {
          "type": "background",
          "color": "surface_field"
         },
         {
          "type": "padding",
          "all": 12
         }
        ],
        "label": "Board",
        "value": "Sprint 24"
       },
       {
        "type": "select_input",
        "id": "field-status",
        "fieldId": "status",
        "label": "Move to",
        "options": [
         {
          "id": "todo",
          "label": "To do"
         },
         {
          "id": "in_progress",
          "label": "In progress"
         },
         {
          "id": "in_review",
          "label": "In review"
         },
         {
          "id": "done",
          "label": "Done"
         },
         {
          "id": "blocked",
          "label": "Blocked"
         }
        ],
        "placeholder": "Choose a status…"
       },
       {
        "type": "column",
        "id": "task-sidebar-tail",
        "modifiers": [
         {
          "type": "weight",
          "value": 1
         }
        ],
        "children": []
       }
      ],
      "spacing": 12
     }
    ],
    "spacing": 32
   }
  ],
  "spacing": 24
 }
}
