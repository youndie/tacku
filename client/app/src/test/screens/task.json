            "label": "Due",
            "value": "29 Aug",
            "helperText": "In 6 days"
           },
           {
            "type": "read_only_field",
            "id": "task-board",
            "modifiers": [
             {
              "type": "background",
              "color": "surface_field"
             },
             {
              "type": "padding",
              "all": 12
             }
            ],
            "label": "Board",
            "value": "Sprint 24"
           },
           {
            "type": "select_input",
            "id": "field-status",
            "fieldId": "status",
            "label": "Move to",
            "options": [
             {
              "id": "todo",
              "label": "To do"
             },
             {
              "id": "in_progress",
              "label": "In progress"
             },
             {
              "id": "in_review",
              "label": "In review"
             },
             {
              "id": "done",
              "label": "Done"
             },
             {
              "id": "blocked",
              "label": "Blocked"
             }
            ],
            "placeholder": "Choose a status…"
           },
           {
            "type": "button",
            "id": "task-mark-done",
            "modifiers": [
             {
              "type": "size",
              "width": "Fill"
             },
             {
              "type": "padding",
              "top": 12,
              "bottom": 12,
              "start": 24,
              "end": 24
             }
            ],
            "text": "Mark as Done",
            "action": {
             "type": "perform",
             "url": "/submit/task-view/TAC-2",
             "payload": {
              "status": {
               "id": "done",
               "title": "Done",
               "type": "entity_value"
              }
             }
            },
            "variant": "primary"
           },
           {
            "type": "row",
            "id": "task-edit",
            "modifiers": [
             {
              "type": "size",
              "width": "Fill"
             }
            ],
            "children": [
             {
              "type": "text",
              "id": "task-edit-label",
              "modifiers": [
               {
                "type": "padding",
                "top": 12,
                "bottom": 12,
                "start": 12,
                "end": 12
               }
              ],
              "text": "Edit task",
              "style": "button_quiet"
             }
            ],
            "action": {
             "type": "navigate",
             "deeplink": "app://edit-task/TAC-2"
            }
           },
           {
            "type": "column",
            "id": "task-sidebar-tail",
            "modifiers": [
             {
              "type": "weight",
              "value": 1
             }
            ],
            "children": []
           }
