                  "children": [
                   {
                    "type": "text",
                    "id": "history-3-what",
                    "text": "Created",
                    "style": "body"
                   },
                   {
                    "type": "text",
                    "id": "history-3-who",
                    "text": "anna · 09:00",
                    "style": "meta"
                   }
                  ],
                  "spacing": 6
                 }
                ]
               }
              ],
              "spacing": 8
             }
            ],
            "spacing": 8
