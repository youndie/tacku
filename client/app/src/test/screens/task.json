                  "type": "size",
                  "width": "Fill"
                 },
                 {
                  "type": "padding",
                  "start": 3
                 }
                ],
                "children": [
                 {
                  "type": "column",
                  "id": "history-3-body",
                  "modifiers": [
                   {
                    "type": "background",
                    "color": "surface_block"
                   },
                   {
                    "type": "size",
                    "width": "Fill"
                   },
                   {
                    "type": "padding",
                    "all": 14
                   }
