             {
              "type": "size",
              "width": "Fill"
             },
             {
              "type": "padding",
              "start": 3
             }
            ],
            "children": [
             {
              "type": "column",
              "id": "history-3-body",
              "modifiers": [
               {
                "type": "background",
                "color": "surface_block"
               },
               {
                "type": "size",
                "width": "Fill"
               },
               {
                "type": "padding",
                "all": 14
               }
              ],
              "children": [
               {
                "type": "text",
                "id": "history-3-what",
                "text": "Created",
                "style": "body"
               },
               {
                "type": "text",
                "id": "history-3-who",
                "text": "anna · 19:30",
                "style": "meta"
