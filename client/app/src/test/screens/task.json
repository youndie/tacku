            "text": "Post",
            "action": {
             "type": "submit_form",
             "formId": "task-view/TAC-2"
            },
            "variant": "primary"
           }
          ]
         }
        ],
        "spacing": 8
       },
       {
        "type": "column",
        "id": "task-left-tail",
        "modifiers": [
         {
          "type": "weight",
          "value": 1
