{
 "schema": {
  "formId": "new-board",
  "fields": [
   {
    "type": "text_field",
    "fieldId": "name",
    "rules": [
     {
      "type": "required",
      "errorMessage": "Give the board a name."
     }
    ]
   }
  ]
 },
 "screen": {
  "type": "column",
  "id": "screen-new-board",
  "modifiers": [
   {
    "type": "background",
    "color": "surface"
   },
   {
    "type": "size",
    "width": "Fill"
   },
   {
    "type": "padding",
    "all": 32
   }
  ],
  "children": [
   {
    "type": "column",
    "id": "new-board-heading",
    "children": [
     {
      "type": "text",
      "id": "new-board-title",
      "text": "New board",
      "style": "display"
     },
     {
      "type": "text",
      "id": "new-board-note",
      "text": "Boards are created by people. Your agent can fill one with tasks, but it cannot make one.",
      "style": "body_muted"
     }
    ],
    "spacing": 6
   },
   {
    "type": "text_input",
    "id": "field-name",
    "fieldId": "name",
    "label": "Name",
    "placeholder": "Platform hardening"
   },
   {
    "type": "read_only_field",
    "id": "board-columns",
    "label": "Columns",
    "value": "To do · In progress · In review · Done · Blocked",
    "helperText": "Every board starts with these five. Renaming them comes later."
   },
   {
    "type": "row",
    "id": "new-board-actions",
    "children": [
     {
      "type": "button",
      "id": "back-board",
      "modifiers": [
       {
        "type": "padding",
        "top": 12,
        "bottom": 12,
        "start": 18,
        "end": 18
       }
      ],
      "text": "← Board",
      "action": {
       "type": "navigate",
       "deeplink": "app://board"
      }
     },
     {
      "type": "button",
      "id": "new-board-submit",
      "modifiers": [
       {
        "type": "padding",
        "top": 12,
        "bottom": 12,
        "start": 24,
        "end": 24
       }
      ],
      "text": "Create board",
      "action": {
       "type": "submit_form",
       "formId": "new-board"
      },
      "variant": "primary"
     },
     {
      "type": "column",
      "id": "new-board-actions-spacer",
      "modifiers": [
       {
        "type": "weight",
        "value": 1
       }
      ],
      "children": []
     }
    ],
    "spacing": 12
   }
  ],
  "spacing": 24
 }
}
