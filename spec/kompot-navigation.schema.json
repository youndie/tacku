  "$defs": {
    "NavigationGraph": {
      "x-kompot-kind": "object",
      "type": "object",
      "properties": {
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScreenRoute"
          }
        }
      },
      "required": [
        "routes"
      ],
      "additionalProperties": true
    },
    "ScreenRoute": {
      "x-kompot-kind": "object",
      "type": "object",
      "properties": {
        "deeplink": {
