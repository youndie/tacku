        },
        "endpoint": {
          "type": "string",
          "pattern": "^/[^\\s#]*$",
          "description": "The relative address the screen tree is fetched from"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "deeplink",
        "endpoint"
      ],
      "additionalProperties": true
    }
  }
}
